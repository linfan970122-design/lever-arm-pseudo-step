+  void NavSatTransform::acceptHeading(const double yaw, const ros::Time &stamp)
+  {
+    last_accepted_yaw_ = yaw;
+    last_accepted_yaw_time_ = stamp;
+    yaw_hold_count_ = 0;
+    heading_valid_ = true;
+    has_pending_yaw_ = false;
+
+    // Restart the gyro propagation from the heading we just trusted
+    gyro_yaw_ = yaw;
+    gyro_yaw_time_ = stamp;
+  }
+
+  void NavSatTransform::gyroCallback(const sensor_msgs::ImuConstPtr& msg)
+  {
+    if (!gyro_yaw_time_.isZero() && msg->header.stamp > gyro_yaw_time_)
+    {
+      gyro_yaw_ = FilterUtilities::clampRotation(
+        gyro_yaw_ + msg->angular_velocity.z * (msg->header.stamp - gyro_yaw_time_).toSec());
+    }
+
+    gyro_yaw_time_ = msg->header.stamp;
+    has_gyro_ = true;
+  }
+
+  bool NavSatTransform::gateHeading(tf2::Quaternion &orientation, const ros::Time &stamp)
+  {
+    double roll;
+    double pitch;
+    double yaw;
+    tf2::Matrix3x3(orientation).getRPY(roll, pitch, yaw);
+
+    // The periodic update can revisit the same heading sample, so gate each sample exactly once and replay the
+    // previous decision otherwise. A repeated sample is trivially consistent with itself and would otherwise be
+    // able to re-anchor the gate on stale data. A repeat is the same sample seen twice, which means the same
+    // stamp AND the same yaw: two distinct samples that merely share a stamp (0.76 % of the frames in the
+    // replay corpus do) still have to be gated, or the reference stops being refreshed and the staleness rule
+    // withholds the output for a fault that never happened.
+    if (!last_gated_time_.isZero() && stamp <= last_gated_time_ && yaw == last_gated_yaw_)
+    {
+      orientation.setRPY(roll, pitch, last_accepted_yaw_);
+      return heading_gate_publish_;
+    }
+    last_gated_time_ = stamp;
+    last_gated_yaw_ = yaw;
+
+    if (last_accepted_yaw_time_.isZero())
+    {
+      acceptHeading(yaw, stamp);
+      heading_gate_publish_ = true;
+      return true;
+    }
+
+    // One nominal interval's worth of rotation. This is deliberately not scaled by the time since the last
+    // accepted heading: a budget that grows while the fault lasts is a gate that opens for the fault.
+    const double budget = max_yaw_rate_ * nominal_dt_ + yaw_gate_margin_;
+    const double since_accept = std::max((stamp - last_accepted_yaw_time_).toSec(), 0.0);
+
+    if (heading_valid_ && since_accept > max_gap_frames_ * nominal_dt_)
+    {
+      // Nothing has refreshed the reference for several intervals, so it no longer bounds anything
+      heading_valid_ = false;
+      has_pending_yaw_ = false;
+      ROS_WARN_THROTTLE(1.0, "navsat_transform: reference heading is %.2f s old and is now considered stale.",
+                        since_accept);
+    }
+
+    if (heading_valid_)
+    {
+      const double delta = FilterUtilities::clampRotation(yaw - last_accepted_yaw_);
+
+      if (std::fabs(delta) <= budget)
+      {
+        acceptHeading(yaw, stamp);
+        heading_gate_publish_ = true;
+        return true;
+      }
+
+      // Not reachable by the platform, so it cannot be real motion. Hold the last accepted yaw: rotating the
+      // lever arm with a bad heading would move the published position by 2*|offset|*sin(delta/2) while leaving
+      // every position quality field untouched.
+      ++yaw_hold_count_;
+      orientation.setRPY(roll, pitch, last_accepted_yaw_);
+
+      if (yaw_hold_count_ >= max_hold_frames_)
+      {
+        heading_valid_ = false;
+        has_pending_yaw_ = false;
+        ROS_WARN_THROTTLE(1.0, "navsat_transform: heading rejected for %d consecutive updates and is now "
+                          "considered invalid. Withholding gps odometry until it can be re-anchored.",
+                          yaw_hold_count_);
+        heading_gate_publish_ = false;
+        return false;
+      }
+
+      ROS_WARN_THROTTLE(1.0, "navsat_transform: heading increment of %.4f rad exceeds the budget of %.4f rad. "
+                        "Holding the last accepted yaw (%d consecutive).", delta, budget, yaw_hold_count_);
+      heading_gate_publish_ = true;
+      return true;
+    }
+
+    // Heading is invalid: the stale accepted yaw is no longer a usable reference, so re-anchor on something
+    // that does not come from before the fault.
+    heading_gate_publish_ = false;
+
+    if (use_gyro_ && has_gyro_ && gyro_yaw_time_ >= last_accepted_yaw_time_ && since_accept <= max_gyro_ref_time_)
+    {
+      // The gyro carries the pre-fault heading forward independently of the source under test, but only for as
+      // long as its bias stays small compared with the budget, hence max_gyro_ref_time_.
+      const double gyro_delta = FilterUtilities::clampRotation(yaw - gyro_yaw_);
+
+      if (std::fabs(gyro_delta) <= budget + gyro_drift_rate_ * since_accept)
+      {
+        acceptHeading(yaw, stamp);
+        heading_gate_publish_ = true;
+        ROS_WARN_THROTTLE(1.0, "navsat_transform: heading re-anchored at %.4f rad against the gyro reference "
+                          "after %.2f s; resuming gps odometry.", yaw, since_accept);
+        return true;
+      }
+
+      orientation.setRPY(roll, pitch, last_accepted_yaw_);
+      return false;
+    }
+
+    // No usable gyro reference: fall back to two consecutive headings that agree with each other
+    if (has_pending_yaw_ && std::fabs(FilterUtilities::clampRotation(yaw - pending_yaw_)) <= budget)
+    {
+      acceptHeading(yaw, stamp);
+      heading_gate_publish_ = true;
+      ROS_WARN_THROTTLE(1.0, "navsat_transform: heading re-anchored at %.4f rad on two consecutive agreeing "
+                        "samples; resuming gps odometry.", yaw);
+      return true;
+    }
+
+    orientation.setRPY(roll, pitch, last_accepted_yaw_);
+    pending_yaw_ = yaw;
+    pending_yaw_time_ = stamp;
+    has_pending_yaw_ = true;
+    return false;
+  }
